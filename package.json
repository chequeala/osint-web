  "scripts": {
    "dev": "npx netlify-cli dev",
    "serve": "node server",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest",
    "dev:vercel": "PLATFORM='vercel' npx vercel dev",
    "dev:netlify": "PLATFORM='netlify' npx netlify-cli dev",
    "dev:node": "npx concurrently --names \"frontend,backend\" \"REACT_APP_API_ENDPOINT='http://localhost:3001/api' npx vite\" \"PLATFORM='node' DISABLE_GUI='true' PORT='3001' API_CORS_ORIGIN='*' npx nodemon server\"",
    "preview": "vite preview"
  },
